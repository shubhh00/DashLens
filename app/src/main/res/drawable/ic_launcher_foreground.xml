<?xml version="1.0" encoding="utf-8"?>
<!-- DashLens mark: one bold cluster gauge with an amber warning lamp in its bottom gap.
     Kept inside the 66dp adaptive-icon safe circle so launcher masks never clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- shifted down 3 units: the heavy arc made the mark look high in the launcher circle -->
    <group android:translateY="3">
        <!-- 270 degree gauge arc, open at the bottom -->
        <path
            android:pathData="M36.67,69.33 A24.5,24.5 0 1,1 71.33,69.33"
            android:strokeWidth="5"
            android:strokeColor="#FFF2F3F5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- ticks -->
        <path
            android:pathData="M37,52 L33.5,52 M42.33,40.33 L39.85,37.85 M54,35 L54,31.5 M65.67,40.33 L68.15,37.85 M71,52 L74.5,52"
            android:strokeWidth="2.6"
            android:strokeColor="#FFF2F3F5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- needle -->
        <path
            android:pathData="M54,52 L64.6,41.4"
            android:strokeWidth="4.2"
            android:strokeColor="#FFF5A623"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- hub -->
        <path
            android:fillColor="#FFF2F3F5"
            android:pathData="M54,52m-3.6,0a3.6,3.6 0,1 1,7.2 0a3.6,3.6 0,1 1,-7.2 0" />
        <!-- amber warning lamp in the gauge gap -->
        <path
            android:pathData="M54,62 L61.5,75 L46.5,75 Z"
            android:fillColor="#FFF5A623"
            android:strokeColor="#FFF5A623"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M54,66.3 L54,70.4"
            android:strokeWidth="2.2"
            android:strokeColor="#FF111315"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:fillColor="#FF111315"
            android:pathData="M54,72.9m-1.2,0a1.2,1.2 0,1 1,2.4 0a1.2,1.2 0,1 1,-2.4 0" />
    </group>
</vector>
