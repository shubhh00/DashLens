AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_AGENT_UID=123456
AGORA_AREA=NORTH_AMERICA
ASR_MODEL=nova-3
LLM_MODEL=gpt-5-mini
LLM_REASONING_EFFORT=low
TTS_MODEL=speech_2_6_turbo
# openai: managed tts-1 voices alloy, echo, fable, onyx, nova, shimmer
# elevenlabs: needs ELEVENLABS_API_KEY; TTS_VOICE_ID is an ElevenLabs voice id
# minimax: set TTS_MODEL and a MiniMax voice id such as Calm_Woman
TTS_VENDOR=openai
TTS_VOICE_ID=onyx
# 1.0 = normal; MiniMax accepts roughly 0.5-2.0
TTS_SPEED=1.1
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=*
TOKEN_EXPIRY_SECONDS=3600
SESSION_TTL_SECONDS=7200
REQUESTS_PER_MINUTE=60
# Public HTTPS URL of this server (e.g. an ngrok tunnel). Required for the manual and helpline tools,
# which Agora's cloud calls over the internet.
PUBLIC_BASE_URL=
# Demo voice: ElevenLabs Flash v2.5, voice "Eric". Set TTS_VENDOR=elevenlabs to use it; each call falls back
# to Agora-managed OpenAI tts-1 (TTS_FALLBACK_VOICE_ID) when fewer than ELEVENLABS_MIN_CHARACTERS are left.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
# TTS_VOICE_ID=cjVigY5qzO86Huf0OWal
TTS_FALLBACK_VOICE_ID=onyx
ELEVENLABS_MIN_CHARACTERS=1000
# Manual pipeline: only needed to add cars that are not already in server/cache.
GEMINI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
